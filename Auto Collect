local MutationFilter = require(script.Parent.MutationFilter)
local VariantFilter = require(script.Parent.VariantFilter)

local FruitFilter = {}

function FruitFilter.Passes(fruit, settings)
	if typeof(fruit) ~= "Instance" or not fruit:IsA("BasePart") then
		return false
	end

	local fruitType = fruit:GetAttribute("FruitType")
	local mutation = fruit:GetAttribute("Mutation")
	local variant = fruit:GetAttribute("Variant")

	-- Missing or invalid attributes fail closed.
	if type(fruitType) ~= "string"
		or settings.fruits[fruitType] ~= true then
		return false
	end

	-- Treat an omitted mutation as "None". Add "None" to Config.Mutations
	-- if you want to make it selectable in the whitelist or blacklist.
	if mutation == nil then
		mutation = "None"
	end

	if not MutationFilter.IsAllowed(mutation, settings) then
		return false
	end

	if not VariantFilter.IsAllowed(variant, settings) then
		return false
	end

	return true
end

return FruitFilter
